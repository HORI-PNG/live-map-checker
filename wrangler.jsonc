/**
 * Wrangler 設定: https://developers.cloudflare.com/workers/wrangler/configuration/
 * 本番は最上位、PR プレビュー用は env.staging（バインディングと vars は継承されないので両方に書く）
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "live-map-checker",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat", "enable_ctx_exports"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "preview_urls": true,
  // Cron は使わない（会場サイトの自動取得は GitHub Actions で行う。.github/workflows/scrape.yml）
  "triggers": { "crons": [] },
  "vars": {
    "APP_ENV": "production",
    "AI_PROVIDER": "anthropic",
    "AI_MODEL": "claude-sonnet-5-5",
    "AI_DAILY_BUDGET_USD": "1.00"
  },
  // デプロイのバージョン。ページのキャッシュの鍵に含め、デプロイ直後に古い HTML を返さないようにする
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // マイグレーションは drizzle-kit generate で作り、wrangler d1 migrations apply で適用する
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lmc-prod",
      "database_id": "9b46d2dd-c996-4b6e-8878-7b57075e3786",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "env": {
    "staging": {
      "triggers": { "crons": [] },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lmc-staging",
          "database_id": "32cfb3ef-4189-45b5-b971-7d35d9a72389",
          "migrations_dir": "drizzle/migrations"
        }
      ],
      "vars": {
        "APP_ENV": "staging",
        "AI_PROVIDER": "mock",
        "AI_MODEL": "mock",
        "AI_DAILY_BUDGET_USD": "0"
      }
    }
  }
}
